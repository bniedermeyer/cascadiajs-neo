  name: string;
  image: string;
  company: string;
  location: string;
}

interface Talk {
  type: "keynote" | "main" | "lightning" | "workshop";
  /** Absent when the Talk had no detail page in the source data. */
  slug?: string;
  title: string;
  speaker: TalkSpeaker;
}

interface Organizer {
