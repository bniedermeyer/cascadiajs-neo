  <section id="pricing" class="text-sound-navy p-8 text-center">
    <h1 class={headingClass}>Pricing</h1>
    <div class="text-left md:mx-auto md:my-4 md:flex md:justify-center">
      {
        /* box-content: the reference has no box-sizing reset, so its 300px
           .ticket is content-box -- 328px outer once its 12px padding and
           2px border are added. Tailwind's preflight would otherwise make
           that 300px outer, 28px narrow per card. */
        tickets.map((ticket) => (
          <div class="border-sound-navy m-2 box-content w-[300px] min-w-[300px] border-2 px-3 py-[22px]">
            <div class="font-serif text-[30px] font-semibold">
              {ticket.name}
            </div>
            <div class="my-2 flex">
              {ticket.subLabel ? (
                <div class="mr-2 font-serif text-[24px] font-thin italic">
                  {ticket.subLabel}
                </div>
              ) : (
                " "
              )}
              <div class="border-sound-navy flex-1 border-b-2" />
            </div>
            <div class="my-8 font-sans text-[64px] font-medium">
              {ticket.price}
            </div>
            <div class="text-[18px] font-semibold">{" "}</div>
            <div class="mt-4 text-[18px]">
              <strong>Includes:</strong>
              <ul class="mt-0 list-disc pl-4">
                {ticket.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {ticket.footnotes.map((note) => (
                <p>{note}</p>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="speakers" class="p-8 text-center">
    <h1 class={headingClass}>Keynotes</h1>
    <div class={gridClass}>
      {
        keynotes.map((talk) => (
          <a href="/2026/" class={talkCardClass}>
            <div class={photoBoxClass}>
              <img
                src={`/past/2026/images/${talk.speaker.image}`}
                alt={`photo of ${talk.speaker.name}`}
                class={photoImgClass}
              />
              <div class={overlayClass}>
                <div class={overlayTextClass}>
                  {talk.slug ? talk.title : "Talk Info Coming Soon"}
                </div>
              </div>
            </div>
            <div class={infoBlockClass}>
              <div class={`${infoNameClass} group-hover:text-cascade-blue`}>
                {talk.speaker.name}
              </div>
              <div class="group-hover:text-cascade-blue">
                {talk.speaker.company}
                <br />
                {talk.speaker.location}
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <h1 class={headingClass}>Speakers</h1>
    <div class={gridClass}>
      {
        speakerTalks.map((talk) => (
          <a href="/2026/" class={talkCardClass}>
            <div class={photoBoxClass}>
              <img
                src={`/past/2026/images/${talk.speaker.image}`}
                alt={`photo of ${talk.speaker.name}`}
                class={photoImgClass}
              />
              <div class={overlayClass}>
                <div class={overlayTextClass}>
                  {talk.slug ? talk.title : "Talk Info Coming Soon"}
                </div>
              </div>
            </div>
            <div class={infoBlockClass}>
              <div class={`${infoNameClass} group-hover:text-cascade-blue`}>
                {talk.speaker.name}
              </div>
              <div class="group-hover:text-cascade-blue">
                {talk.speaker.company}
                <br />
                {talk.speaker.location}
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <h1 class={headingClass}>Organizers</h1>
    <div class={gridClass}>
      {
        organizers.map((organizer) => (
          <div class="mr-2 mb-4 flex w-[250px] flex-col">
            <div class={photoBoxClass}>
              <img
                src={`/past/2026/images/${organizer.image}`}
                alt={`photo of ${organizer.name}`}
                class={photoImgClass}
              />
            </div>
            <div class={infoBlockClass}>
              <div class={infoNameClass}>{organizer.name}</div>
              <div>
                {organizer.role}
                <br />
                {organizer.location}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="sponsors" class="p-8 text-center">
    <h1 class="mt-0 mb-8 text-[48px]">Our Sponsors</h1>
    <SponsorsGrid event="2026" tiered={true} />
    <CtaButton href="/2026/">Sponsor Our Event</CtaButton>
  </section>

  <section id="testimonials" class="p-8 text-center">
    <Testimonials />
  </section>
</Layout>
