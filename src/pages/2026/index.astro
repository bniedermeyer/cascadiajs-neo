const photoBoxClass = "relative h-[250px] w-[250px] overflow-hidden";
const photoImgClass = "h-[250px] w-[250px] max-w-[250px] object-cover";
const overlayClass =
  "hidden md:block md:absolute md:inset-0 md:bg-cascade-blue md:opacity-0 md:[transition:opacity_0.5s_ease] md:group-hover:opacity-100";
const overlayTextClass =
  "m-4 text-left font-display text-[28px] leading-[1.125em] font-light text-white";
const infoBlockClass = "flex flex-1 flex-col p-2 text-left text-sound-navy";
const infoNameClass =
  "m-0 flex-grow font-serif text-[24px] leading-[1em] font-bold";
const gridClass =
  "flex overflow-x-auto min-[1200px]:flex-wrap min-[1200px]:items-start min-[1200px]:justify-center";
const headingClass = "mt-0 mb-8 text-[48px]";
const paragraphClass =
  "text-sound-navy font-serif text-[24px] leading-[1.5em] font-normal";
---

<Layout
  title="CascadiaJS 2026 | June 1 - 2 | Seattle, WA"
  description="CascadiaJS 2026 is coming up June 1 - 2 in Seattle, WA!"
  displayNav={false}
>
  <section id="hero" class="relative min-h-[100svh] overflow-hidden text-left">
    <video
      class="h-[max(100svh,600px)] w-full scale-[1.2] object-cover object-center"
      preload="auto"
      muted
      autoplay
      loop
      playsinline
    >
      <source src="/past/2026/video/sizzle.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-black/40"></div>
    {
      /*
        The overlay is shrink-to-fit, but the browser caps that at the width
        available after the 3vw left offset — which is what makes the headline
        wrap instead of running off-screen. max-w reproduces that cap.

        The h2's 40px vertical margins look wrong against the reference's
        `.video-overlay h2 { margin: 0 }`, but that rule loses: the same
        stylesheet has `#landing h2 { margin: 40px 0 }`, and an ID selector
        outranks a class. 40px is what actually renders (ADR-0001).

        The lockup stays inline inside a wrapper div, as in the reference —
        Tailwind's preflight would otherwise make it block and drop the ~4px
        of descender space below the baseline-aligned image.
      */
    }
    <div
      class="absolute top-[3vw] left-[3vw] max-w-[calc(100%-3vw)] text-white"
    >
      <div>
        <img
          src="/past/2026/images/lockup-horizontal-webai-white.png"
          alt="CascadiaJS 2026 Web + AI conference"
          class="inline w-[300px]"
        />
      </div>
      <h2 class="my-10 font-serif text-[clamp(16px,8vw,60px)] text-white">
        A Web + AI conference for the Pacific Northwest
      </h2>
      <p class="text-[clamp(18px,2vw,24px)] text-white md:w-1/2">
        CascadiaJS is a community-driven conference for developers in the PNW
        and beyond. You will hear from amazing speakers, connect with 500+
        fellow devs, and explore the latest in web and AI technologies with some
        of the top companies in the industry.
      </p>
      <p class="w-1/2 font-serif text-[clamp(18px,2vw,24px)] leading-[1.125]">
        June 1-2, 2026<br />Town Hall Seattle<br />Seattle, WA, USA
      </p>
      <a
        class="font-display border-cascade-blue bg-cascade-blue text-cedar-cream hover:border-sound-navy hover:bg-sound-navy my-4 inline-block border-4 px-4 py-2 text-[24px] font-medium no-underline"
      >
        SOLD OUT <i class="fa-solid fa-tree"></i>
      </a>
    </div>
  </section>

