---
import { getCollection } from "astro:content";
import EventLayout from "../../../layouts/EventLayout.astro";
import PersonDetail from "../../../components/PersonDetail.astro";
import CtaButton from "../../../components/CtaButton.astro";
import SponsorsGrid from "../../../components/SponsorsGrid.astro";
import Testimonials from "../../../components/Testimonials.astro";
import MarkdownContent from "../../../components/MarkdownContent.astro";
import { marked } from "marked";
import SimplePage from "../../../layouts/SimplePage.astro";

export async function getStaticPaths() {
  const talks = await getCollection("talks");
  return talks
    .filter((talk) => talk.data.slug && talk.data.type !== "workshop")
    .map((talk) => ({
      params: { slug: talk.data.slug! },
      props: { talk: talk.data },
    }));
}

const { talk } = Astro.props;
const { title, abstract, tags, yt, speaker } = talk;

const abstractHtml = marked.parse(abstract ?? "") as string;

// Legacy title string, hardcoded year included.
const metaTitle = `CascadiaJS 2026 | Speakers | ${speaker.name}`;
---

<EventLayout title={metaTitle}>
  <SimplePage title={title}>
    {
      tags && (
        <div class="mb-2 flex flex-wrap">
          {tags.map((tag) => (
            <div class="bg-overcast-gray m-0.75 p-2">{tag}</div>
          ))}
        </div>
      )
    }
    <MarkdownContent>
      <div set:html={abstractHtml} />
    </MarkdownContent>
    {
      yt && (
        <div>
          <iframe
            width="560"
            height="315"
            src={`https://www.youtube.com/embed/${yt}`}
            title="YouTube video player"
            class="border-0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          />
        </div>
      )
    }
    <h2 class="text-32">About {speaker.name}</h2>
    <PersonDetail
      name={speaker.name}
      image={speaker.image}
      company={speaker.company}
      location={speaker.location}
      pronouns={speaker.pronouns}
      social={speaker.social}
      url={speaker.url}
    />
    <CtaButton href="/2026/tickets">
      🎟️ Tickets to CascadiaJS 2026 on sale now!
    </CtaButton>
    <Fragment slot="after-body">
      <section id="sponsors" class="box-content p-8 text-center">
        <h1 class="mt-0 mb-8 text-5xl">Our Sponsors</h1>
        <SponsorsGrid event="2026" tiered={true} />
        <CtaButton href="/2026/sponsor">Sponsor Our Event</CtaButton>
      </section>
      <Testimonials />
    </Fragment>
  </SimplePage>
</EventLayout>
