---
import Layout from "./Layout.astro";
import MarkdownContent from "../components/MarkdownContent.astro";

interface Props {
  title: string;
  description?: string;
  width?: "narrow" | "wide";
  showSponsors?: boolean;
  showTestimonials?: boolean;
}

const {
  title,
  description,
  width = "narrow",
  showSponsors = true,
  showTestimonials = true,
} = Astro.props;
const eventYear = Astro.url.pathname.split("/")[1]?.match(/^(\d{4})$/)?.[1];
const titlePrefix = eventYear ? `CascadiaJS ${eventYear} | ` : "CascadiaJS | ";
const metaTitle = title ? `${titlePrefix}${title}` : `CascadiaJS ${eventYear}`;
---

<Layout title={metaTitle} description={description ?? metaTitle}>
  <MarkdownContent
    title={title}
    width={width}
    showSponsors={showSponsors}
    showTestimonials={showTestimonials}
  >
    <slot />
  </MarkdownContent>
</Layout>
