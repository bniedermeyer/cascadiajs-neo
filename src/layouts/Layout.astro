---
import "../styles/global.css";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE } from "@shared/site-defaults";
import { routePath } from "@shared/route-path";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  displayNav?: boolean;
  displayAlert?: boolean;
}

const {
  description = DEFAULT_DESCRIPTION,
  displayNav = true,
  displayAlert = true,
  ogImage = "/images/2026/share/social-sharing-general.png",
  title = DEFAULT_TITLE,
} = Astro.props;

const origin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(routePath(Astro.url), origin).href;
const ogImageUrl = new URL(ogImage, origin).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* ---- Analytics (dormant) ----------------------------------------
         TODO: enable at migration cutover. Ported verbatim from legacy
         app/head.mjs; nothing below is emitted. To enable, remove the whole
         curly-brace-plus-comment wrapper around this block, not just the
         comment markers (leftover braces would be parsed as an expression),
         and add `is:inline` to EVERY script tag, including the external
         gtag loader (the `async src` one): Astro processes scripts that
         have a src too, and would bundle or drop them without it.
         Don't write a bare script tag in this prose: Vite's dependency
         scanner regex-matches script tags even inside comments and would
         parse the text up to the next closing tag as JavaScript.
         Also invert or remove the "no analytics traces" test in
         e2e/head.spec.ts, which fails once these snippets are emitted.
         Don't write a star-slash inside this comment: it would end it early.

         Google tag (gtag.js), GA4:

         <script async src="https://www.googletagmanager.com/gtag/js?id=G-XBTPEH9RZW"></script>
         <script>
           window.dataLayer = window.dataLayer || [];
           function gtag(){dataLayer.push(arguments);}
           gtag('js', new Date());

           gtag('config', 'G-XBTPEH9RZW');
         </script>

         Meta Pixel Code (its <noscript> fallback image lives at the end of
         <body>, since an <img> is invalid in <head>):

         <script>
         !function(f,b,e,v,n,t,s)
         {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
         n.callMethod.apply(n,arguments):n.queue.push(arguments)};
         if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
         n.queue=[];t=b.createElement(e);t.async=!0;
         t.src=v;s=b.getElementsByTagName(e)[0];
         s.parentNode.insertBefore(t,s)}(window, document,'script',
         'https://connect.facebook.net/en_US/fbevents.js');
         fbq('init', '1431763387943877');
         fbq('track', 'PageView');
         </script>
         ------------------------------------------------------------------ */
    }
    <meta name="author" content="CascadiaJS" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <!-- TODO: remove this once we're live -->
    <meta name="robots" content="noindex, nofollow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@cascadiajs" />

    <!-- Fonts: Adobe Typekit -->
    <link rel="stylesheet" href="https://use.typekit.net/nln6hzq.css" />

    <!-- Icons: Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    {
      /* Paid-tier glyphs (fa-taco, etc.) not in the free CDN stylesheet
         above. `is:inline` emits the tag verbatim instead of bundling it. */
    }
    <script
      is:inline
      src="https://kit.fontawesome.com/95fd764ad0.js"
      crossorigin="anonymous"
      async></script>
  </head>
  <!-- grid-cols-[100%] avoids the implicit `auto` column sizing to
       max-content, which would let an overwide section (2026 pricing row)
       stretch the whole grid. -->
  <body
    class="bg-seafoam-cream md:grid md:min-h-screen md:grid-cols-[100%] md:grid-rows-[auto_1fr_auto]"
  >
    <SiteHeader displayNav={displayNav} displayAlert={displayAlert} />

    <main class="text-lg font-extralight">
      <slot />
    </main>

    <SiteFooter />
    {
      /* TODO: enable at migration cutover. Meta Pixel <noscript> fallback,
         dormant like the head snippets above. It is the last child of
         <body> because an <img> in <head> is invalid and makes the parser
         close the head early. To enable, remove the whole curly-brace-plus-
         comment wrapper, not just the comment markers. (This tag is plain
         HTML, not a script tag, so it needs no `is:inline`.)

         <noscript><img height="1" width="1" style="display:none"
         src="https://www.facebook.com/tr?id=1431763387943877&ev=PageView&noscript=1"
         /></noscript>
      */
    }
  </body>
</html>
